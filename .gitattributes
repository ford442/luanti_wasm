# Forces all files which git considers text files to use LF line endings
* text=auto eol=lf

*.cpp diff=cpp
*.h diff=cpp

*.gltf binary
*.x binary

# Luanti schematics are zlib blobs. Opt in to readable diffs with:
#   git config diff.mts.textconv "python3 util/content/mts_to_text.py"
*.mts -text diff=mts
