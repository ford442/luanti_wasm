	table.insert(table_content, words[math.random(#words)])
	table.insert(table_content, words[math.random(#words)])
	table.insert(table_content, math.random(0, 7))
	table.insert(table_content, math.random(0, 7))
	table.insert(table_content, math.random(0, 7))
	table.insert(table_content, words[math.random(#words)])
end

math.randomseed(reseed)

