{
  "name": "luanti_wasm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Luanti (formerly Minetest) compiled to WebAssembly: browser shell, launcher and build tooling.",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "scripts": {
    "build": "bash -lc 'source \"${EMSDK:-/root/emsdk}/emsdk_env.sh\" && cmake --preset Emscripten && cmake --build build-wasm --parallel $(($(nproc) + 1))'",
    "lint": "eslint client/web util/wasm eslint.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "proxy:install": "npm ci --prefix util/wasm/proxy",
    "test": "npm test --prefix util/wasm/proxy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ford442/luanti_wasm.git"
  },
  "license": "LGPL-2.1-or-later",
  "bugs": {
    "url": "https://github.com/ford442/luanti_wasm/issues"
  },
  "homepage": "https://github.com/ford442/luanti_wasm#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "7.0.2"
  }
}
