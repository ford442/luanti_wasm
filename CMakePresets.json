{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 12
  },
  "configurePresets": [
    {
      "name": "Debug",
      "displayName": "Debug",
      "description": "Debug preset with debug symbols and no optimizations",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "displayName": "Release",
      "description": "Release preset with optimizations and no debug symbols",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "RelWithDebInfo",
      "displayName": "RelWithDebInfo",
      "description": "Release with debug symbols",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "MinSizeRel",
      "displayName": "MinSizeRel",
      "description": "Release with minimal code size",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "EmscriptenBase",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "binaryDir": "${sourceDir}/build-wasm",
      "cacheVariables": {
        "BUILD_CLIENT": "TRUE",
        "BUILD_SERVER": "FALSE",
        "BUILD_UNITTESTS": "FALSE",
        "BUILD_BENCHMARKS": "FALSE",
        "ENABLE_LTO": "FALSE",
        "ENABLE_SOUND": "TRUE",
        "ENABLE_CURL": "FALSE",
        "ENABLE_GETTEXT": "FALSE",
        "ENABLE_CURSES": "FALSE",
        "ENABLE_POSTGRESQL": "FALSE",
        "ENABLE_LEVELDB": "FALSE",
        "ENABLE_REDIS": "FALSE",
        "ENABLE_PROMETHEUS": "FALSE",
        "ENABLE_SPATIAL": "FALSE",
        "ENABLE_OPENSSL": "FALSE",
        "ENABLE_GLES2": "TRUE",
        "ENABLE_OPENGL": "FALSE",
        "ENABLE_OPENGL3": "FALSE",
        "RUN_IN_PLACE": "TRUE"
      },
      "hidden": true
    },
    {
      "name": "Emscripten",
      "displayName": "Emscripten (WebAssembly)",
      "description": "Client-only Release WASM build via pinned Emscripten. Run after sourcing emsdk_env.sh: cmake --preset Emscripten",
      "inherits": "EmscriptenBase",
      "binaryDir": "${sourceDir}/build-wasm",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "EmscriptenDebug",
      "displayName": "Emscripten Debug",
      "description": "Debug WASM build: ASSERTIONS=2, SAFE_HEAP, source maps. Slow; for diagnosing crashes",
      "inherits": "EmscriptenBase",
      "binaryDir": "${sourceDir}/build-wasm-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "EmscriptenProfile",
      "displayName": "Emscripten Profile",
      "description": "Optimised WASM build with function names and source maps for browser profiling",
      "inherits": "EmscriptenBase",
      "binaryDir": "${sourceDir}/build-wasm-profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ]
}
