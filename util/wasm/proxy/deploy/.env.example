PROXY_DOMAIN=proxy.example.org
# The page(s) allowed to open a WebSocket. Comma separated; https://*.pages.dev
# matches subdomains. "*" disables the check and turns the proxy into a relay
# for any website: do not use it on a public deployment.
PROXY_ALLOWED_ORIGINS=https://play.example.org
PROXY_METRICS_TOKEN=change-me
# Reach any public server whose port is in PROXY_ALLOWED_PORTS...
PROXY_ALLOW_PUBLIC=0
PROXY_ALLOWED_PORTS=30000-30010
# ...or only servers listed in the public directory (any port they register):
# PROXY_SERVER_LIST_URL=https://servers.luanti.org/list.json
# Exact endpoints that are always allowed, including private ones.
PROXY_ALLOWED_TARGETS=127.0.0.1:30000
